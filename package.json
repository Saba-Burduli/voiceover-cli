{
  "name": "voiceover-plugin",
  "version": "0.3.1",
  "description": "Claude Code plugin: narrate the demo videos Claude builds in your own voice",
  "type": "module",
  "bin": {
    "voiceover": "dist/voiceover.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && esbuild src/cli.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/voiceover.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.6.0"
  },
  "license": "MIT"
}
